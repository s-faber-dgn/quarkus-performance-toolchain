  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "id": 1,
      "title": "Heap genutzt und reserviert",
      "description": "Genutzten Heap mit dem von der JVM reservierten Heap vergleichen. Reserviert ist nicht gleich maximal verfügbar.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"quarkus\",area=\"heap\"})",
          "legendFormat": "genutzt",
          "refId": "A"
        },
        {
          "expr": "sum(jvm_memory_committed_bytes{job=\"quarkus\",area=\"heap\"})",
          "legendFormat": "reserviert",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "Heap-Belegung des reservierten Speichers",
      "description": "Genutzter Anteil des aktuell reservierten Heaps. Für Lecksuche vor allem den Verlauf nach GC beachten.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"quarkus\",area=\"heap\"}) / sum(jvm_memory_committed_bytes{job=\"quarkus\",area=\"heap\"})",
          "refId": "A"
        }
      ]
    },
