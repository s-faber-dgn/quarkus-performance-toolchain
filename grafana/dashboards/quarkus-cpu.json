    {
      "id": 1,
      "title": "Prozess-CPU-Auslastung",
      "description": "Anteil der CPU-Kapazität, den der Java-Prozess nutzt. Mit System-CPU und Durchsatz vergleichen.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "process_cpu_usage{job=\"quarkus\"}",
          "refId": "A"
        }
      ]
    },
    {
