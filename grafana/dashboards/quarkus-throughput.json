{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "id": 1,
      "title": "Requests pro Sekunde",
      "description": "Gesamtdurchsatz über alle instrumentierten HTTP-Endpunkte. /q/metrics ist in der Regel ausgenommen.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"quarkus\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx-Fehlerquote",
      "description": "Anteil der Serverfehler an allen instrumentierten HTTP-Anfragen.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"quarkus\",status=~\"5..\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=\"quarkus\"}[1m])) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Mittlere Antwortzeit",
      "description": "Gewichteter Mittelwert über alle HTTP-Anfragen. Benötigt mindestens zwei Scrapes und echte App-Anfragen.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"quarkus\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=\"quarkus\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Maximale Antwortzeit",
      "description": "Größter von Micrometer aktuell gemeldeter Zeitfenster-Maximalwert; kein Perzentil.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max(http_server_requests_seconds_max{job=\"quarkus\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Durchsatz nach Endpunkt und Status",
      "description": "Die zehn stärksten Kombinationen aus Methode, Route und Status.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "topk(10, sum by (method, uri, status) (rate(http_server_requests_seconds_count{job=\"quarkus\"}[1m])))",
          "refId": "A",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Aktive HTTP-Anfragen",
      "description": "Gleichzeitig laufende Anfragen. Steigt dieser Wert bei konstantem Durchsatz, dauern Anfragen länger.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(http_server_active_requests{job=\"quarkus\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Aktive HTTP-Verbindungen",
      "description": "Offene HTTP-Verbindungen, inklusive Keep-Alive-Verbindungen.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(http_server_active_connections{job=\"quarkus\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Worker-Warteschlange",
      "description": "Anstehende Worker-Aufgaben. Anhaltender Anstieg kann den Durchsatz begrenzen.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(worker_pool_queue_size{job=\"quarkus\"})",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
